package main

import (
	"strconv"

	af "github.com/authfly/authkit/packages/ui/templ/authfly"
	"github.com/authfly/authkit/packages/ui/templ/ui/box"
	"github.com/authfly/authkit/packages/ui/templ/ui/button"
	"github.com/authfly/authkit/packages/ui/templ/ui/checkbox"
	"github.com/authfly/authkit/packages/ui/templ/ui/form"
	"github.com/authfly/authkit/packages/ui/templ/ui/input"
	"github.com/authfly/authkit/packages/ui/templ/ui/label"
	"github.com/authfly/authkit/packages/ui/templ/ui/link"
	selectx "github.com/authfly/authkit/packages/ui/templ/ui/select"
	"github.com/authfly/authkit/packages/ui/templ/ui/text"
	"github.com/authfly/authkit/packages/ui/templ/ui/textarea"
	uiutils "github.com/authfly/authkit/packages/ui/templ/utils"
)

// document is the one place with html, head and body (no UI8Kit primitive exists for the document root). Everything
// else is built from the UI8Kit 3 primitives (authkit packages/ui/templ) and the console layer in ui.templ.
templ document(pageTitle string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ pageTitle } - Authfly Console</title>
			<link rel="stylesheet" href="/assets/app.css"/>
			<script src="/assets/theme.js"></script>
		</head>
		<body class="bg-background text-foreground">
			{ children... }
		</body>
	</html>
}

templ brand() {
	@link.Link(link.LinkProps{Href: "/", Class: "flex items-center gap-2 font-semibold"}) {
		@lucide("terminal", "md", "")
		@text.Text(text.TextProps{Tag: "span"}) {
			Authfly Console
		}
	}
}

templ loginView(csrf, errMsg string) {
	@document("Sign in") {
		@box.Box(box.BoxProps{Tag: "main", Class: "flex min-h-screen w-full items-center justify-center px-4 py-8"}) {
			@uiCard("w-full max-w-sm", nil) {
				@uiCardHeader() {
					@af.Group("2", "center", "between", "", nil) {
						@brand()
						@themeToggle()
					}
					@uiCardDescription("Private configurator for Stalwart and Authfly. Reachable on localhost only.")
				}
				@uiCardContent("") {
					@form.Form(form.FormProps{Action: "/login", Method: "post", Class: "flex flex-col gap-4", Attrs: templ.Attributes{"data-testid": "login-form"}}) {
						@input.Input(input.InputProps{Type: "hidden", Name: "csrf", Value: csrf})
						if errMsg != "" {
							@uiAlert("destructive", nil) {
								@text.Text(text.TextProps{Class: "text-sm"}) {
									{ errMsg }
								}
							}
						}
						@af.Stack("2", "", "", "", nil) {
							@label.Label(label.LabelProps{For: "username", Class: labelClass}) {
								Username
							}
							@input.Input(input.InputProps{ID: "username", Name: "username", Required: true, Class: controlClass, Attrs: templ.Attributes{"autocomplete": "username"}})
						}
						@af.Stack("2", "", "", "", nil) {
							@label.Label(label.LabelProps{For: "password", Class: labelClass}) {
								Password
							}
							@input.Input(input.InputProps{ID: "password", Name: "password", Type: "password", Required: true, Class: controlClass, Attrs: templ.Attributes{"autocomplete": "current-password"}})
						}
						@button.Button(button.ButtonProps{Type: "submit", Class: btnClass("", "", "w-full")}) {
							Sign in
						}
					}
				}
			}
		}
	}
}

func navLinkClass(on bool) string {
	if on {
		return "block rounded-md bg-muted px-2 py-2 text-sm font-medium text-foreground"
	}
	return "block rounded-md px-2 py-2 text-sm text-muted-foreground hover:bg-muted hover:text-foreground"
}

templ navTree(p PageVM) {
	@af.Stack("6", "", "", "", nil) {
		for _, g := range p.Nav {
			@af.Stack("2", "", "", "", nil) {
				@af.Group("2", "center", "", "", nil) {
					@lucide(iconOr(g.Icon), "sm", "text-muted-foreground")
					@text.Text(text.TextProps{Class: "uppercase text-muted-foreground text-xs font-semibold"}) {
						{ g.Title }
					}
				}
				@box.Box(box.BoxProps{Tag: "ul", Class: "flex flex-col gap-1"}) {
					for _, it := range g.Items {
						@box.Box(box.BoxProps{Tag: "li"}) {
							@link.Link(link.LinkProps{Href: it.View, Class: navLinkClass(it.View == p.Current)}) {
								{ it.Label }
							}
						}
					}
				}
			}
		}
	}
}

templ layout(p PageVM) {
	@document(p.Title) {
		@box.Box(box.BoxProps{Tag: "header", Class: "sticky top-0 z-10 w-full border-b border-border bg-background"}) {
			@box.Box(box.BoxProps{Class: "mx-auto flex h-16 w-full max-w-7xl items-center justify-between gap-4 px-4"}) {
				@brand()
				@af.Group("2", "center", "", "", nil) {
					@uiBadge("outline", "", "hidden md:inline-flex", p.User)
					@themeToggle()
					@form.Form(form.FormProps{Action: "/logout", Method: "post"}) {
						@input.Input(input.InputProps{Type: "hidden", Name: "csrf", Value: p.Csrf})
						@button.Button(button.ButtonProps{Type: "submit", Class: btnClass("ghost", "sm", ""), Attrs: templ.Attributes{"data-testid": "logout"}}) {
							@lucide("log-out", "sm", "")
							@text.Text(text.TextProps{Tag: "span", Class: "sr-only md:not-sr-only"}) {
								Sign out
							}
						}
					}
				}
			}
		}
		@box.Box(box.BoxProps{Class: "mx-auto flex w-full max-w-7xl flex-col gap-8 px-4 py-6 lg:flex-row"}) {
			@box.Box(box.BoxProps{Tag: "aside", Class: "hidden w-64 lg:block"}) {
				@box.Box(box.BoxProps{Tag: "nav", Class: "sticky top-20 max-h-screen overflow-auto pb-24", Attrs: templ.Attributes{"aria-label": "Console"}}) {
					@navTree(p)
				}
			}
			@box.Box(box.BoxProps{Tag: "main", Class: "flex min-w-0 flex-1 flex-col gap-6"}) {
				@box.Box(box.BoxProps{Tag: "nav", Class: "lg:hidden", Attrs: templ.Attributes{"aria-label": "Console sections"}}) {
					@form.Form(form.FormProps{Action: "/go", Method: "get", Class: "flex gap-2"}) {
						@selectx.Select(selectx.SelectProps{Name: "to", Value: p.Current, Options: mobileNav(p.Nav), Class: uiutils.Cn(selectClass, "w-full"), Attrs: templ.Attributes{"aria-label": "Go to"}})
						@button.Button(button.ButtonProps{Type: "submit", Class: btnClass("outline", "", "")}) {
							Go
						}
					}
				}
				@af.Stack("2", "", "", "", nil) {
					if len(p.Crumbs) > 0 {
						@af.Group("2", "center", "", "flex-wrap text-sm text-muted-foreground", nil) {
							for i, cr := range p.Crumbs {
								if i > 0 {
									@lucide("chevron-right", "sm", "")
								}
								@link.Link(link.LinkProps{Href: cr.Href, Class: "hover:text-foreground"}) {
									{ cr.Label }
								}
							}
						}
					}
					@text.Text(text.TextProps{Tag: "h1", Class: "break-words text-2xl font-semibold"}) {
						{ p.Title }
					}
					if p.Subtitle != "" {
						@text.Text(text.TextProps{Class: "text-muted-foreground"}) {
							{ p.Subtitle }
						}
					}
				}
				@blocks(p.Blocks, p.Csrf)
			}
		}
	}
}

templ blocks(bs []Block, csrf string) {
	for _, b := range bs {
		@oneBlock(b, csrf)
	}
}

func toneVariant(t string) string {
	if t == "destructive" {
		return "destructive"
	}
	return "default"
}

func stepIcon(s string) string {
	switch s {
	case "ok":
		return "circle-check"
	case "fail":
		return "circle-x"
	case "warn":
		return "triangle-alert"
	}
	return "circle-dashed"
}

func stepClass(s string) string {
	switch s {
	case "ok":
		return "text-primary"
	case "fail":
		return "text-destructive"
	}
	return "text-muted-foreground"
}

templ cardHead(b Block) {
	if b.Title != "" || b.Text != "" {
		@uiCardHeader() {
			if b.Title != "" {
				@af.Group("2", "center", "", "flex-wrap", nil) {
					if b.Icon != "" {
						@lucide(b.Icon, "md", "text-muted-foreground")
					}
					@uiCardTitle(b.Title)
					if b.Badge != "" {
						@uiBadge("secondary", "", "", b.Badge)
					}
				}
			}
			if b.Text != "" {
				@uiCardDescription(b.Text)
			}
		}
	}
}

templ oneBlock(b Block, csrf string) {
	switch b.Kind {
		case "alert":
			@uiAlert(b.Tone, templ.Attributes{"data-testid": "alert-" + b.Tone}) {
				@af.Stack("2", "", "", "", nil) {
					@af.Group("2", "center", "", "", nil) {
						@lucide(iconOr(b.Icon), "sm", "")
						@text.Text(text.TextProps{Class: "text-sm font-semibold"}) {
							{ b.Title }
						}
					}
					if b.Text != "" {
						@text.Text(text.TextProps{Class: "text-sm"}) {
							{ b.Text }
						}
					}
					if len(b.Items) > 0 {
						@box.Box(box.BoxProps{Tag: "ul", Class: "flex flex-col gap-1"}) {
							for _, it := range b.Items {
								@box.Box(box.BoxProps{Tag: "li", Class: "text-sm"}) {
									{ "- " + it }
								}
							}
						}
					}
				}
			}
		case "grid":
			@box.Box(box.BoxProps{Class: "grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"}) {
				for _, ch := range b.Children {
					@oneBlock(ch, csrf)
				}
			}
		case "stat":
			@link.Link(link.LinkProps{Href: b.Code, Class: "block"}) {
				@uiCard("h-full hover:bg-muted", nil) {
					@uiCardContent("flex items-center gap-4 pt-6") {
						@lucide(iconOr(b.Icon), "lg", "text-muted-foreground")
						@af.Stack("0", "", "", "", nil) {
							@text.Text(text.TextProps{Class: "text-2xl font-semibold"}) {
								{ b.Badge }
							}
							@text.Text(text.TextProps{Class: "text-muted-foreground text-sm"}) {
								{ b.Title }
							}
						}
					}
				}
			}
		default:
			@uiCard("min-w-0", templ.Attributes{"data-block": b.Kind}) {
				@cardHead(b)
				@uiCardContent("flex min-w-0 flex-col gap-4") {
					@blockBody(b, csrf)
				}
			}
	}
}

templ blockBody(b Block, csrf string) {
	if len(b.Items) > 0 {
		@box.Box(box.BoxProps{Tag: "ul", Class: "flex flex-col gap-2"}) {
			for _, it := range b.Items {
				@box.Box(box.BoxProps{Tag: "li", Class: "flex gap-2 text-sm"}) {
					@lucide("dot", "sm", "text-muted-foreground")
					@text.Text(text.TextProps{Tag: "span", Class: "min-w-0 break-words"}) {
						{ it }
					}
				}
			}
		}
	}
	if len(b.KV) > 0 {
		@box.Box(box.BoxProps{Tag: "dl", Class: "grid grid-cols-1 gap-2 md:grid-cols-3"}) {
			for _, kv := range b.KV {
				@box.Box(box.BoxProps{Tag: "dt", Class: "text-sm text-muted-foreground"}) {
					{ kv[0] }
				}
				@box.Box(box.BoxProps{Tag: "dd", Class: "break-words text-sm md:col-span-2"}) {
					{ kv[1] }
				}
			}
		}
	}
	if len(b.Steps) > 0 {
		@box.Box(box.BoxProps{Tag: "ul", Class: "flex flex-col gap-4", Attrs: templ.Attributes{"data-testid": "steps"}}) {
			for _, st := range b.Steps {
				@box.Box(box.BoxProps{Tag: "li", Class: "flex gap-2", Attrs: templ.Attributes{"data-status": st.Status}}) {
					@lucide(stepIcon(st.Status), "md", stepClass(st.Status))
					@af.Stack("0", "", "", "min-w-0", nil) {
						@text.Text(text.TextProps{Class: "text-sm font-medium"}) {
							{ st.Title }
						}
						if st.Detail != "" {
							@text.Text(text.TextProps{Class: "break-words text-muted-foreground text-sm"}) {
								{ st.Detail }
							}
						}
					}
				}
			}
		}
	}
	if len(b.Links) > 0 {
		@box.Box(box.BoxProps{Tag: "ul", Class: "flex flex-col gap-2"}) {
			for _, l := range b.Links {
				@box.Box(box.BoxProps{Tag: "li"}) {
					@link.Link(link.LinkProps{Href: l.Href, Class: "flex items-start gap-2 rounded-md p-2 hover:bg-muted"}) {
						@lucide(iconOr(l.Icon), "sm", "text-muted-foreground")
						@af.Stack("0", "", "", "min-w-0", nil) {
							@af.Group("2", "center", "", "", nil) {
								@text.Text(text.TextProps{Class: "text-sm font-medium"}) {
									{ l.Label }
								}
								if l.Badge != "" {
									@uiBadge("outline", "sm", "", l.Badge)
								}
							}
							if l.Text != "" {
								@text.Text(text.TextProps{Class: "text-muted-foreground text-sm"}) {
									{ l.Text }
								}
							}
						}
					}
				}
			}
		}
	}
	if b.Table != nil {
		@dataTable(*b.Table)
	}
	if b.Code != "" {
		@box.Box(box.BoxProps{Class: "max-h-screen overflow-auto rounded-md border border-border bg-muted p-4"}) {
			@text.Text(text.TextProps{Tag: "pre", Class: "font-mono text-xs", Attrs: templ.Attributes{"data-testid": "code"}}) {
				{ b.Code }
			}
		}
	}
	if b.Form != nil {
		@formView(*b.Form, csrf)
	}
	if len(b.Forms) > 0 {
		@af.Group("2", "", "", "flex-wrap", nil) {
			for _, f := range b.Forms {
				@formView(f, csrf)
			}
		}
	}
}

templ dataTable(t Table) {
	if len(t.Rows) == 0 {
		@text.Text(text.TextProps{Class: "text-muted-foreground text-sm"}) {
			{ t.Empty }
		}
	} else {
		@box.Box(box.BoxProps{Class: "w-full overflow-auto"}) {
			@box.Box(box.BoxProps{Tag: "table", Class: "w-full text-sm", Attrs: templ.Attributes{"data-testid": "table"}}) {
				@box.Box(box.BoxProps{Tag: "thead", Class: "border-b border-border"}) {
					@box.Box(box.BoxProps{Tag: "tr", Class: "border-b border-border"}) {
						for _, c := range t.Cols {
							@box.Box(box.BoxProps{Tag: "th", Class: "px-2 py-2 text-left align-middle font-semibold", Attrs: templ.Attributes{"scope": "col"}}) {
								{ c }
							}
						}
					}
				}
				@box.Box(box.BoxProps{Tag: "tbody"}) {
					for _, r := range t.Rows {
						@box.Box(box.BoxProps{Tag: "tr", Class: "border-b border-border"}) {
							for i, c := range r.Cells {
								@box.Box(box.BoxProps{Tag: "td", Class: "px-2 py-2 align-middle max-w-xs truncate"}) {
									if i == 0 && r.Href != "" {
										@link.Link(link.LinkProps{Href: r.Href, Class: "font-medium underline-offset-4 hover:underline"}) {
											{ nonEmpty(c, "(open)") }
										}
									} else {
										{ c }
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

templ formView(f FormVM, csrf string) {
	@form.Form(form.FormProps{ID: f.ID, Action: f.Action, Method: "post", Class: formClass(f.Inline), Attrs: templ.Attributes{"data-testid": "form-" + f.ID}}) {
		@input.Input(input.InputProps{Type: "hidden", Name: "csrf", Value: csrf})
		for _, h := range f.Hidden {
			@input.Input(input.InputProps{Type: "hidden", Name: h[0], Value: h[1]})
		}
		for _, fl := range f.Fields {
			@fieldView(fl)
		}
		if f.Note != "" {
			@text.Text(text.TextProps{Class: "text-muted-foreground text-sm"}) {
				{ f.Note }
			}
		}
		@af.Group("2", "", "", "", nil) {
			@button.Button(button.ButtonProps{Type: "submit", Class: btnClass(nonEmpty(f.Variant, "default"), "", ""), Attrs: templ.Attributes{"data-testid": "submit-" + f.ID}}) {
				{ f.Submit }
			}
		}
	}
}

func formClass(inline bool) string {
	if inline {
		return "flex flex-wrap items-end gap-2"
	}
	return "flex flex-col gap-4"
}

templ fieldView(f Field) {
	switch f.Kind {
		case "bool":
			@af.Group("2", "start", "", "", nil) {
				@checkbox.Checkbox(checkbox.CheckboxProps{ID: "f-" + f.Name, Name: f.Name, Value: "true", Checked: f.Value == "true", Attrs: templ.Attributes{"aria-describedby": "d-" + f.Name}, Class: af.CheckboxSkin()})
				@af.Stack("0", "", "", "", nil) {
					@label.Label(label.LabelProps{For: "f-" + f.Name, Class: labelClass}) {
						{ f.Label }
					}
					@fieldHelp(f)
				}
			}
		default:
			@af.Stack("2", "", "", "min-w-0", nil) {
				@af.Group("2", "center", "", "flex-wrap", nil) {
					@label.Label(label.LabelProps{For: "f-" + f.Name, Class: labelClass}) {
						{ f.Label }
					}
					if f.Required {
						@uiBadge("outline", "sm", "", "required")
					}
					if f.Ref != "" {
						@uiBadge("secondary", "sm", "", "→ " + trimX(f.Ref))
					}
					if f.Format != "" && f.Format != "string" {
						@uiBadge("secondary", "sm", "", f.Format)
					}
				}
				switch f.Kind {
					case "enum", "ref", "select":
						@selectx.Select(selectx.SelectProps{ID: "f-" + f.Name, Name: f.Name, Value: f.Value, Options: selOpts(f), Required: f.Required, Attrs: templ.Attributes{"aria-describedby": "d-" + f.Name}, Class: selectClass})
					case "json", "textarea":
						@textarea.Textarea(textarea.TextareaProps{ID: "f-" + f.Name, Name: f.Name, Value: f.Value, Rows: strconv.Itoa(rowsFor(f)), Class: uiutils.Cn(textareaClass, "font-mono text-xs"), Placeholder: jsonPlaceholder(f), Attrs: templ.Attributes{"aria-describedby": "d-" + f.Name, "spellcheck": "false"}})
					case "readonly":
						@input.Input(input.InputProps{ID: "f-" + f.Name, Value: f.Value, Disabled: true, Class: controlClass})
					default:
						@input.Input(input.InputProps{ID: "f-" + f.Name, Name: f.Name, Type: inputType(f), Value: f.Value, Required: f.Required, Placeholder: placeholder(f), Attrs: mergeAttrs(inputAttrs(f), templ.Attributes{"autocomplete": autoc(f)}), Class: controlClass})
				}
				@fieldHelp(f)
			}
	}
}

templ fieldHelp(f Field) {
	if f.Err != "" {
		@text.Text(text.TextProps{Class: "text-destructive text-sm", Attrs: templ.Attributes{"data-testid": "field-error", "role": "alert"}}) {
			{ f.Err }
		}
	}
	if f.Desc != "" {
		@text.Text(text.TextProps{Class: "text-muted-foreground text-xs", Attrs: templ.Attributes{"id": "d-" + f.Name}}) {
			{ f.Desc }
		}
	}
}
