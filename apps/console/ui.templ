package main

// Console middle layer on the UI8Kit 3 templ primitives (authkit packages/ui/templ): card, alert, badge, table,
// controls and Lucide icons, composed with className + tokens only (the xgen card/table/alert/badge bricks are gone in
// v3). Card, alert, badge and button take the authkit Authfly skin (af.*Skin), so ring/control classes stay in the kit. Text is always passed as props or { } (escaped).

import (
	af "github.com/authfly/authkit/packages/ui/templ/authfly"
	"github.com/authfly/authkit/packages/ui/templ/ui/box"
	"github.com/authfly/authkit/packages/ui/templ/ui/button"
	"github.com/authfly/authkit/packages/ui/templ/ui/icon"
	"github.com/authfly/authkit/packages/ui/templ/ui/text"
	uiutils "github.com/authfly/authkit/packages/ui/templ/utils"
)

func consoleIcon(name string) string {
	if s, ok := consoleIcons[name]; ok {
		return s
	}
	return consoleIcons["circle"]
}

// lucide: a Lucide glyph in the Icon primitive. size xs|sm|md|lg|xl (16px = sm, 20px = md, 24px = lg).
templ lucide(name, size, class string) {
	@icon.Icon(icon.IconProps{Size: size, Class: class, Attrs: templ.Attributes{"data-lucide": name}}) {
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="100%" height="100%" aria-hidden="true" focusable="false">
			@templ.Raw(consoleIcon(name))
		</svg>
	}
}

templ uiCard(class string, attrs templ.Attributes) {
	@box.Box(box.BoxProps{Class: af.CardSkin("mx-0 max-w-none gap-8", class), Attrs: attrs}) {
		{ children... }
	}
}

templ uiCardHeader() {
	@box.Box(box.BoxProps{Class: "grid auto-rows-min items-start gap-2"}) {
		{ children... }
	}
}

templ uiCardTitle(title string) {
	@text.Text(text.TextProps{Tag: "h2", Class: "font-semibold leading-none"}) {
		{ title }
	}
}

templ uiCardDescription(desc string) {
	@text.Text(text.TextProps{Class: "text-sm text-muted-foreground"}) {
		{ desc }
	}
}

templ uiCardContent(class string) {
	@box.Box(box.BoxProps{Class: class}) {
		{ children... }
	}
}

// uiAlert: the Authfly alert skin (tone default | success | warning | destructive; only destructive changes the colours);
// role alert for destructive/warning, status otherwise; aria-live polite.
templ uiAlert(tone string, attrs templ.Attributes) {
	@box.Box(box.BoxProps{Class: af.AlertSkin(tone), Attrs: mergeAttrs(templ.Attributes{"role": alertRole(tone), "aria-live": "polite", "data-slot": "alert"}, attrs)}) {
		{ children... }
	}
}

// badgeClass: the Authfly badge skin (h-6 px-2); size sm is h-5.
func badgeClass(variant, size, class string) string {
	sz := ""
	if size == "sm" {
		sz = "h-5"
	}
	return af.BadgeSkin(nonEmpty(variant, "default"), sz, class)
}

templ uiBadge(variant, size, class, label string) {
	@text.Text(text.TextProps{Tag: "span", Class: badgeClass(variant, size, class), Attrs: templ.Attributes{"data-slot": "badge"}}) {
		{ label }
	}
}

// btnClass: the Authfly button skin; size sm is h-8 (the skin keeps px-4).
func btnClass(variant, size, class string) string {
	if size == "sm" {
		return af.ButtonSkin(nonEmpty(variant, "default"), uiutils.Cn("h-8", class))
	}
	return af.ButtonSkin(nonEmpty(variant, "default"), class)
}

// themeToggle: Button primitive wired by assets/theme.js ([data-ui8kit="theme-toggle"], aria-pressed).
templ themeToggle() {
	@button.Button(button.ButtonProps{Type: "button", Class: af.ButtonSkin("ghost", "w-10 px-0"), AriaLabel: "Dark mode", AriaPressed: "false", Attrs: templ.Attributes{"data-ui8kit": "theme-toggle", "data-testid": "theme-toggle"}}) {
		@text.Text(text.TextProps{Tag: "span", Class: "dark:hidden"}) {
			@lucide("moon", "md", "")
		}
		@text.Text(text.TextProps{Tag: "span", Class: "hidden dark:inline"}) {
			@lucide("sun", "md", "")
		}
	}
}

const (
	controlClass  = "h-10 w-full min-w-0 rounded bg-background px-3 text-base text-foreground inset-ring inset-ring-input outline-none placeholder:text-muted-foreground focus-visible:inset-ring-ring disabled:cursor-not-allowed disabled:opacity-50 md:text-sm"
	selectClass   = "h-10 w-full min-w-0 rounded bg-background px-3 text-sm text-foreground inset-ring inset-ring-input outline-none focus-visible:inset-ring-ring disabled:cursor-not-allowed disabled:opacity-50"
	textareaClass = "min-h-20 w-full min-w-0 rounded bg-background px-3 py-2 text-base text-foreground inset-ring inset-ring-input outline-none placeholder:text-muted-foreground focus-visible:inset-ring-ring disabled:cursor-not-allowed disabled:opacity-50 md:text-sm"
	labelClass    = "text-sm font-semibold text-foreground"
)
