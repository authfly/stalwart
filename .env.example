# Dev-only values for the local stack (docker compose reads .env). Never use these on a server.
#   cp .env.example .env && docker compose up -d --build
STALWART_ADMIN_PASSWORD=dev-only-stalwart-password
AUTHFLY_SERVICE_PASSWORD=dev-only-authfly-service-password
AUTHFLY_SECRET=dev-only-authfly-secret-at-least-32-characters
AUTHFLY_ADMIN_KEY=dev-only-authfly-admin-key-0000000000
CONSOLE_ADMIN=console:dev-only-console-password
CONSOLE_SECRET=dev-only-console-secret-at-least-32-chars
